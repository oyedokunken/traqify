# ─── API (same-origin proxy) ──────────────────────────────────────────────────
# The browser only calls /api/* on this site; middleware.ts forwards those calls to the API.
# Server side only: these are not exposed to the browser.
# Local: http://localhost:5000 | Production (Vercel): the API project's URL
API_ORIGIN=http://localhost:5000
# Must match PROXY_SHARED_SECRET on the API. Generate with: openssl rand -hex 32
PROXY_SHARED_SECRET=

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Local: http://localhost:3000 | Production (Vercel): https://traqify.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
