# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Copy from: Supabase → Project Settings → Database → Connection string
# Transaction pooler URL (used by Prisma in production with pgbouncer):
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection URL (used for Prisma migrations):
DIRECT_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Local: http://localhost:3000 | Production (Vercel): https://traqify.vercel.app
FRONTEND_URL=http://localhost:3000

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=

# ─── Same-origin proxy and session cookie ────────────────────────────────────
# The web app calls this API through its own /api routes, so the browser only ever talks to FRONTEND_URL.
# FRONTEND_URL must be the exact origin of the web app (scheme and host, no trailing slash): it is used for
# CORS, for the CSRF origin check and for the Google sign in redirect URI (FRONTEND_URL/api/auth/google-callback).
# PROXY_SHARED_SECRET must be the same value in the web app: the proxy sends the visitor's IP with it, and the
# API only believes that IP when the secret matches. Generate with: openssl rand -hex 32
PROXY_SHARED_SECRET=
# The refresh cookie is httpOnly, Secure in production and SameSite=Lax. Leave this empty unless you know why.
COOKIE_SAMESITE=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Copy from: Supabase → Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Requires Gmail App Password (not account password). The server must support STARTTLS (587) or implicit TLS (465); certificates are always verified.
# Enable at: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Traqify <your@gmail.com>"

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Paystack ─────────────────────────────────────────────────────────────────
# Copy from: dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ─── Vercel Cron (keep Supabase DB alive) ─────────────────────────────────────
# Vercel injects Authorization: Bearer <CRON_SECRET> on every cron invocation.
# Set this in: Vercel project → Settings → Environment Variables → CRON_SECRET
# Generate a value with: openssl rand -hex 32
CRON_SECRET=
