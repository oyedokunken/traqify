{
  "version": 2,
  "regions": ["lhr1"],
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/housekeeping",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/wishlist-reminders",
      "schedule": "0 9 * * *"
    }
  ]
}
